# Neon: Connection string (Pooled) del proyecto NUEVO "habertronic-orion"
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Clave secreta para tokens JWT (cámbiala por una frase larga)
JWT_SECRET=cambia-esto-por-una-clave-secreta-muy-larga

PORT=3001

# Orígenes permitidos (dev + Netlify)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://habertronic-orion.netlify.app

# Open-Meteo (API Standard / customer)
OPEN_METEO_API_KEY=pega-aqui-tu-api-key
OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
OPEN_METEO_AIR_BASE_URL=https://customer-air-quality-api.open-meteo.com
OPEN_METEO_GEO_BASE_URL=https://customer-geocoding-api.open-meteo.com

# PIN de Orión DB / panel admin (header X-Admin-Pin)
ADMIN_DASHBOARD_PIN=6666

# --- Backups (npm run db:backup) ---
# Copia local siempre en backend/backups/*.json.gz
#
# AWS S3 (capa gratuita / free tier):
# 1) Crea bucket p.ej. orion-backups-TUUSUARIO (región us-east-1)
# 2) IAM usuario con política PutObject solo a ese bucket
# 3) Access key en:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BACKUP_S3_BUCKET=orion-backups-TUUSUARIO
# BACKUP_TO_S3=1
#
# Google Drive (tu cuenta):
# 1) Activa Google Drive API + OAuth cliente "Escritorio"
#    Redirect: http://127.0.0.1:53682/oauth2callback
# 2) npm run db:backup:drive-auth  → pega el refresh token
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
# (Si no pones FOLDER_ID, se crea/usa la carpeta "Orion-Backups" en Mi unidad)
# BACKUP_TO_DRIVE=1
