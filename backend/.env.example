# Neon: Connection string (Pooled) del proyecto NUEVO "habertronic-orion"
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Clave secreta para tokens JWT (cámbiala por una frase larga)
JWT_SECRET=cambia-esto-por-una-clave-secreta-muy-larga

PORT=3001

# Orígenes permitidos (dev + Netlify cuando exista)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
